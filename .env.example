# General config
VIDEO_PROVIDER=veo
PUBLIC_BASE_URL=https://your-public-url.ngrok.app

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/autocontent

# Google AI Studio / Gemini
GOOGLE_AI_STUDIO_API_KEY=your_gemini_api_key_here

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=gcp-service-account.json

# Vidu API (Optional)
VIDU_API_KEY=your_vidu_api_key_here

# Ngrok
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# YouTube OAuth (for publish-service)
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
